# Copy this file to .env and set GEMINI_API_KEY. Nothing else has to be changed.
# Both Docker commands read the same file: docker run --env-file .env ... adapt|eval
# Precedence: process environment > solution/.env > repository .env > workspace ../.env
# Never commit a real key.

# --- Required ------------------------------------------------------------
GEMINI_API_KEY=

# --- Judge model ---------------------------------------------------------
# Used by `adapt` for baseline predictions and by `eval` for every test example.
# `adapt` and `eval` must run with the same judge model and parameters; eval rejects a mismatch.
MODEL=gemini/gemini-flash-latest
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=120

# --- Meta model ----------------------------------------------------------
# The stronger model that learns the prompts during `adapt`: prompt synthesis,
# evidence stripping and the jury explanation. Not used at prediction time.
META_MODEL=gemini/gemini-4-argon
# Optional per-stage overrides; when unset, both follow META_MODEL.
# SYNTHESIS_MODEL=gemini/gemini-4-argon
# EXPLANATION_MODEL=gemini/gemini-4-argon
SYNTHESIS_MAX_OUTPUT_TOKENS=32768
EXPLANATION_MAX_OUTPUT_TOKENS=16384
SYNTHESIS_TIMEOUT_SECONDS=900

# --- Per-case analysis during `adapt` ------------------------------------
# Reads every labeled training example; defaults to the judge model.
ANALYSIS_MODEL=gemini/gemini-flash-latest
ANALYSIS_MAX_OUTPUT_TOKENS=3072

# --- Spending cap --------------------------------------------------------
# Estimated USD for adaptation plus one evaluation, including failed attempts.
# A stage stops before any request that would exceed it.
RUN_BUDGET_USD=10

# --- Pacing and transient failures ---------------------------------------
MAX_CONCURRENCY=3
REQUEST_INTERVAL_SECONDS=4.1
# Attempts per request including the first; only 429, 5xx and timeouts are retried.
MAX_ATTEMPTS=4
# First backoff in seconds; doubles per retry, half jitter, capped at 60.
RETRY_BACKOFF_SECONDS=5

# --- Legacy ---------------------------------------------------------------
# Only for the experiments in experiments/; the packaged solution ignores it.
EXPERIMENT_BUDGET_USD=10
