# Copy to .env; the existing ../.env is also supported. Never commit real keys.
GEMINI_API_KEY=
MODEL=gemini/gemini-flash-latest
# Production pipeline: adapt + one eval share this estimated USD cap.
RUN_BUDGET_USD=10
ANALYSIS_MODEL=gemini/gemini-flash-latest
SYNTHESIS_MODEL=gemini/gemini-4-argon
EXPLANATION_MODEL=gemini/gemini-4-argon
ANALYSIS_MAX_OUTPUT_TOKENS=3072
SYNTHESIS_MAX_OUTPUT_TOKENS=32768
EXPLANATION_MAX_OUTPUT_TOKENS=16384
SYNTHESIS_TIMEOUT_SECONDS=900
MAX_CONCURRENCY=3
REQUEST_INTERVAL_SECONDS=4.1
# Attempts per request, including the first; transient 429/5xx/timeout only.
MAX_ATTEMPTS=4
# First backoff in seconds; doubles per retry, half jitter, capped at 60.
RETRY_BACKOFF_SECONDS=5
# Legacy experiments retain their separate budget setting.
EXPERIMENT_BUDGET_USD=10
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=120
